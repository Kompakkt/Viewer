{
  "name": "kompakkt",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:docker": "ng serve --host=0.0.0.0 --disable-host-check",
    "local": "ng serve --host=0.0.0.0",
    "build": "ng build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "update:kompakkt:common": "bun run update-git-dependency.ts -d @kompakkt/common -o Kompakkt -r Common -b main",
    "update:kompakkt:komponents": "bun run update-git-dependency.ts -d @kompakkt/komponents -o Kompakkt -r Komponents -b main",
    "update:kompakkt:plugins": "bun run update-git-dependency.ts -d @kompakkt/plugins -o Kompakkt -r Plugins -b main",
    "update:kompakkt:server-openapi": "bun run update-git-dependency.ts -d @kompakkt/server-openapi -o Kompakkt -r Server -b openapi-types",
    "extract-translations": "ts-node --skipProject ./extract-translations.ts"
  },
  "contributors": [
    {
      "name": "Zoe Schubert"
    },
    {
      "name": "Kai Niebes"
    },
    {
      "name": "Jan Wieners",
      "email": "mail@jan-wieners.de",
      "url": "https://jan-wieners.de"
    }
  ],
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@angular/animations": "21.2.6",
    "@angular/cdk": "21.2.4",
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/forms": "21.2.6",
    "@angular/material": "21.2.4",
    "@angular/platform-browser": "21.2.6",
    "@angular/platform-browser-dynamic": "21.2.6",
    "@angular/router": "21.2.6",
    "@babylonjs/core": "9.0.0",
    "@babylonjs/gui": "9.0.0",
    "@babylonjs/gui-editor": "9.0.0",
    "@babylonjs/inspector": "9.0.0",
    "@babylonjs/loaders": "9.0.0",
    "@babylonjs/materials": "9.0.0",
    "@babylonjs/serializers": "9.0.0",
    "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#49b7d222f9d6edd719ae7183ba53c96acedd9d0f",
    "@kompakkt/fragments": "git+https://github.com/Kompakkt/engine_fragment#a58a35a1cc530c4d0589df197e99da82eae6d1fa",
    "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#094e77280596c4d82bca0627ce6f257a6e99496e",
    "@kompakkt/plugins": "git+https://github.com/Kompakkt/Plugins.git#3ce5c36c4a82683c984fed0ca259217c49878e91",
    "@kompakkt/server-openapi": "git+https://github.com/Kompakkt/Server.git#d73de702a6b2a94c4824f95e5fef008ac18d572b",
    "bson-objectid": "^2.0.4",
    "copc": "^0.0.8",
    "fast-deep-equal": "^3.1.3",
    "file-saver": "^2.0.5",
    "fscreen": "^1.2.0",
    "laz-perf": "^0.0.7",
    "lazts": "^1.0.0",
    "localforage": "^1.10.0",
    "marked": "^17.0.5",
    "ngx-color": "^10.1.0",
    "pepjs": "^0.5.3",
    "rfdc": "^1.4.1",
    "rxjs": "7.8.2",
    "tslib": "^2.6.3",
    "uuid": "^14.0.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "21.2.5",
    "@angular/compiler-cli": "21.2.6",
    "@angular/language-service": "21.2.6",
    "@types/bun": "^1.3.11",
    "@types/emscripten": "^1.40.0",
    "@types/file-saver": "^2.0.7",
    "@types/fscreen": "^1.0.4",
    "@types/localforage": "^0.0.34",
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@kompakkt/komponents": {
      "@angular/core": "21.2.6"
    },
    "@kompakkt/plugins": {
      "@angular/core": "21.2.6",
      "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#1ec9e452e73a999d2b5ff725febd95dc0774a19f"
    }
  },
  "trustedDependencies": [
    "@kompakkt/common",
    "@kompakkt/plugins"
  ]
}
