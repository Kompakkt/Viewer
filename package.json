{
  "name": "kompakkt",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:docker": "ng serve --host=0.0.0.0 --disable-host-check",
    "local": "ng serve --host=0.0.0.0",
    "build": "ng build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check",
    "update:kompakkt:common": "bun run update-git-dependency.ts -d @kompakkt/common -o Kompakkt -r Common -b main",
    "update:kompakkt:komponents": "bun run update-git-dependency.ts -d @kompakkt/komponents -o Kompakkt -r Komponents -b main",
    "update:kompakkt:plugins": "bun run update-git-dependency.ts -d @kompakkt/plugins -o Kompakkt -r Plugins -b main",
    "update:kompakkt:server-openapi": "bun run update-git-dependency.ts -d @kompakkt/server-openapi -o Kompakkt -r Server -b openapi-types",
    "extract-translations": "ts-node --skipProject ./extract-translations.ts"
  },
  "contributors": [
    {
      "name": "Zoe Schubert"
    },
    {
      "name": "Kai Niebes"
    },
    {
      "name": "Jan Wieners",
      "email": "mail@jan-wieners.de",
      "url": "https://jan-wieners.de"
    }
  ],
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@babylonjs/core": "9.32.1",
    "@babylonjs/gui": "9.32.1",
    "@babylonjs/gui-editor": "9.32.1",
    "@babylonjs/inspector": "9.32.1",
    "@babylonjs/loaders": "9.32.1",
    "@babylonjs/materials": "9.32.1",
    "@babylonjs/serializers": "9.32.1",
    "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#044af84217ffafddad839841cc35a9e9027f5e3c",
    "@kompakkt/fragments": "git+https://github.com/Kompakkt/engine_fragment#a58a35a1cc530c4d0589df197e99da82eae6d1fa",
    "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#a8299aa77713b01270aa43d2a69a3a6ba26959e7",
    "@kompakkt/plugins": "git+https://github.com/Kompakkt/Plugins.git#0ff71dfc2f48041b5e8ea3d652f7c0101f2813ad",
    "@kompakkt/server-openapi": "git+https://github.com/Kompakkt/Server.git#9728b208cecb7b7193448324025a94b9c35ac1f2",
    "bson-objectid": "^2.0.4",
    "copc": "^0.0.8",
    "fast-deep-equal": "^3.1.3",
    "file-saver": "^2.0.5",
    "fscreen": "^1.2.0",
    "laz-perf": "^0.0.7",
    "lazts": "^1.0.0",
    "localforage": "^1.10.0",
    "marked": "^17.0.5",
    "ngx-color": "^10.1.0",
    "pepjs": "^0.5.3",
    "rfdc": "^1.4.1",
    "rxjs": "7.8.2",
    "tslib": "^2.6.3",
    "uuid": "^14.0.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@types/bun": "^1.3.11",
    "@types/emscripten": "^1.40.0",
    "@types/file-saver": "^2.0.7",
    "@types/fscreen": "^1.0.4",
    "@types/localforage": "^0.0.34",
    "@types/node": "^25.5.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@kompakkt/komponents": {
      "@angular/core": "22.2.3"
    },
    "@kompakkt/plugins": {
      "@angular/core": "22.2.3",
      "@kompakkt/common": "git+https://github.com/Kompakkt/Common.git#044af84217ffafddad839841cc35a9e9027f5e3c",
      "@kompakkt/komponents": "git+https://github.com/Kompakkt/Komponents.git#a8299aa77713b01270aa43d2a69a3a6ba26959e7"
    }
  },
  "trustedDependencies": [
    "@kompakkt/common",
    "@kompakkt/plugins"
  ]
}